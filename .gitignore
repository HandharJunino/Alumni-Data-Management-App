# Project-wide .gitignore for Alumni Data Management App

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
.claude/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Python specific (Django backend)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc
*.pyo
*.pyd
.env
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Django specific
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
local_settings.py
/static/

# Database files
*.sqlite3
*.db

# Flutter specific (Frontend)
**/build/
# Netlify serves straight from this directory in git - see
# .github/workflows/frontend-ci.yml
!frontend-flutter/build/
frontend-flutter/build/*
!frontend-flutter/build/web/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/pubspec.lock

# Flutter web build
**/web/build/

# Flutter coverage
**/coverage/

# Flutter test coverage
**/test/.test_coverage.dart

# Node.js (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies
**/node_modules/

# Temporary files
*.tmp
*.temp
temp/
tmp/

# Archive files
*.zip
*.tar.gz
*.rar
*.7z

# Backup files
*.bak
*.backup
*.old

# Documentation build
docs/_build/

# PyCharm
.idea/

# VSCode
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json
.vscode/extensions.json

# Jupyter Notebook
.ipynb_checkpoints

# Git
*.orig

# Local configuration files
config/local.py
settings/local.py
